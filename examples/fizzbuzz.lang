// Classic FizzBuzz, plus break/continue demo.
let i = 1;
while (i <= 20) {
  if (i % 15 == 0) {
    print "FizzBuzz";
  } else {
    if (i % 3 == 0) {
      print "Fizz";
    } else {
      if (i % 5 == 0) {
        print "Buzz";
      } else {
        print str(i);
      }
    }
  }
  i = i + 1;
}

print "---";

let n = 0;
while (n < 10) {
  n = n + 1;
  if (n % 2 == 0) {
    continue;
  }
  if (n > 7) {
    break;
  }
  print "odd: " + str(n);
}
